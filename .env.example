# Platform (wtt-platform)
PORT=4008
NODE_ENV=development
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
JWT_SECRET=change-me-to-64-char-random-string
JWT_EXPIRES_IN=7d

# Service URLs
AUTH_SERVICE_URL=http://localhost:4001
NOTIFY_SERVICE_URL=http://localhost:4002
PAYMENTS_SERVICE_URL=http://localhost:4003

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx

# Frontend URLs
WEB_URL=http://localhost:3003
ADMIN_URL=http://localhost:3004
